# OS garbage
.DS_Store

# Auth files
auth.json

# State files
dot-config/aws
dot-config/gcloud
dot-config/lazygit/state.yml
dot-config/lazydocker/state.yml
dot-config/configstore

# Any kind of license file...
**/*.bttlicense

# Tmux Plugins
dot-config/tmux/plugins/*

# Ignore all in .ssh dir except for config files
dot-ssh/*
!dot-ssh/config
!dot-ssh/config.home

# Ignore all in .gemini dir except for settings file
dot-gemini/*
!dot-gemini/settings.json

# Ignore all in .claude dir except for settings file and skills
dot-claude/*
!dot-claude/settings.json
!dot-claude/skills

# Ignore all in opencode dir except for settings and plugins
dot-config/opencode/*
!dot-config/opencode/agent/
!dot-config/opencode/opencode.*
!dot-config/opencode/plugin/

# Ignore all in codex dir except for config files
dot-codex/*
!dot-codex/config.toml
!dot-codex/*.config.toml

# Ignore all log files
**/*.log

# Ignore yazi flavors
dot-config/yazi/flavors/catppuccin-mocha.yazi/*

# Ignore BTT logs
Library/Application Support/BetterTouchTool/Logs/*

/dot-config/filezilla
/dot-config/herdr/session.json
/dot-config/lazyjira/jql_history
/dot-config/cagent
/dot-config/herdr/release-notes.json
